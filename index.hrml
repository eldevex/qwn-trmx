<!DOCTYPE html>
<html lang="ru" class="scroll-smooth">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Qwen API Proxy — OpenAI-совместимый API для Qwen</title>
<script src="https://cdn.tailwindcss.com"></script>
<script>
  tailwind.config = {
    theme: {
      extend: {
        colors: {
          bg: '#0a0b10',
          surface: '#12141c',
          border: '#1f2230',
          accent: '#7c8cff',
          accent2: '#a78bfa',
          green: '#4ade80',
          red: '#f87171',
          yellow: '#fbbf24',
        },
        fontFamily: {
          mono: ['JetBrains Mono', 'Fira Code', 'monospace'],
        },
        animation: {
          'fade-in': 'fadeIn 0.6s ease-out',
          'slide-up': 'slideUp 0.5s ease-out',
          'glow': 'glow 3s ease-in-out infinite',
        },
        keyframes: {
          fadeIn: { '0%': { opacity: '0' }, '100%': { opacity: '1' } },
          slideUp: { '0%': { opacity: '0', transform: 'translateY(20px)' }, '100%': { opacity: '1', transform: 'translateY(0)' } },
          glow: { '0%, 100%': { opacity: '0.4' }, '50%': { opacity: '0.8' } },
        }
      }
    }
  }
</script>
<style>
  body { background: #0a0b10; color: #e4e6eb; }
  ::-webkit-scrollbar { width: 8px; height: 8px; }
  ::-webkit-scrollbar-track { background: #12141c; }
  ::-webkit-scrollbar-thumb { background: #1f2230; border-radius: 4px; }
  ::-webkit-scrollbar-thumb:hover { background: #2e3344; }
  .gradient-text {
    background: linear-gradient(135deg, #7c8cff 0%, #a78bfa 50%, #f472b6 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .glow-bg {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.35;
    pointer-events: none;
  }
  details summary::-webkit-details-marker { display: none; }
  details summary { list-style: none; }
  details[open] .chevron { transform: rotate(90deg); }
  .chevron { transition: transform 0.2s ease; }
  pre { position: relative; }
  .copy-btn {
    position: absolute;
    top: 10px; right: 10px;
    background: #1f2230;
    color: #9aa0ac;
    border: none;
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 0.75rem;
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.2s, background 0.15s;
  }
  pre:hover .copy-btn { opacity: 1; }
  .copy-btn:hover { background: #2e3344; color: #fff; }
  .copy-btn.copied { background: #4ade80; color: #0a0b10; }
</style>
</head>
<body class="font-sans antialiased">

<!-- ===== NAV ===== -->
<nav class="fixed top-0 w-full z-50 backdrop-blur-lg bg-bg/80 border-b border-border">
  <div class="max-w-5xl mx-auto px-6 py-4 flex items-center justify-between">
    <a href="#" class="flex items-center gap-2 font-semibold text-lg">
      <span class="w-8 h-8 rounded-lg bg-gradient-to-br from-accent to-accent2 flex items-center justify-center text-white text-sm font-bold">Q</span>
      <span class="gradient-text">Qwen Proxy</span>
    </a>
    <div class="hidden md:flex items-center gap-6 text-sm text-gray-400">
      <a href="#features" class="hover:text-white transition">Возможности</a>
      <a href="#install" class="hover:text-white transition">Установка</a>
      <a href="#faq" class="hover:text-white transition">FAQ</a>
      <a href="https://github.com/eldevex/qwn-trmx" target="_blank" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-surface border border-border hover:border-accent hover:text-white transition">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
        GitHub
      </a>
    </div>
  </div>
</nav>

<!-- ===== HERO ===== -->
<section class="relative pt-32 pb-20 px-6 overflow-hidden">
  <div class="glow-bg w-96 h-96 bg-accent -top-20 -left-20 animate-glow"></div>
  <div class="glow-bg w-80 h-80 bg-accent2 top-40 -right-20 animate-glow" style="animation-delay: 1s;"></div>
  <div class="glow-bg w-72 h-72 bg-pink-500 bottom-0 left-1/3 animate-glow" style="animation-delay: 2s; opacity: 0.2;"></div>

  <div class="max-w-4xl mx-auto text-center relative z-10 animate-fade-in">
    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-surface border border-border text-xs text-gray-400 mb-6">
      <span class="w-2 h-2 rounded-full bg-green-400 animate-pulse"></span>
      v7 · работает на Android
    </div>
    <h1 class="text-4xl md:text-6xl font-bold leading-tight mb-6 tracking-tight">
      <span class="gradient-text">Qwen API</span> прямо<br>
      на твоём телефоне
    </h1>
    <p class="text-lg md:text-xl text-gray-400 max-w-2xl mx-auto mb-10 leading-relaxed">
      OpenAI-совместимый сервер для <code class="px-2 py-1 rounded bg-surface text-accent text-sm">chat.qwen.ai</code>. Работает через Termux, автоматически обновляет токен и подключается к любому клиенту: Kai 9000, Open WebUI, Chatbox, SillyTavern.
    </p>
    <div class="flex flex-wrap items-center justify-center gap-4">
      <a href="#install" class="px-6 py-3 rounded-xl bg-gradient-to-r from-accent to-accent2 text-white font-semibold hover:opacity-90 transition shadow-lg shadow-accent/20">
        🚀 Начать установку
      </a>
      <a href="https://github.com/eldevex/qwn-trmx" target="_blank" class="px-6 py-3 rounded-xl bg-surface border border-border hover:border-accent transition">
        📦 Открыть репозиторий
      </a>
    </div>
  </div>
</section>

<!-- ===== WARNING ===== -->
<section class="max-w-4xl mx-auto px-6 pb-16">
  <div class="p-5 rounded-2xl border border-red-500/30 bg-red-500/5 animate-slide-up">
    <div class="flex gap-4">
      <div class="text-2xl">⚠️</div>
      <div>
        <h3 class="font-semibold text-red-300 mb-1">Используйте на свой страх и риск</h3>
        <p class="text-sm text-gray-400 leading-relaxed">
          Проект работает через недокументированный web-API Qwen. Это может нарушать условия использования и привести к блокировке аккаунта. Автор не несёт ответственности за заблокированные аккаунты, неверные ответы модели или любые другие последствия. Используйте <strong class="text-white">одноразовый аккаунт</strong>, который не жалко потерять.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- ===== FEATURES ===== -->
<section id="features" class="max-w-5xl mx-auto px-6 py-16">
  <div class="text-center mb-12">
    <h2 class="text-3xl md:text-4xl font-bold mb-3">✨ <span class="gradient-text">Возможности</span></h2>
    <p class="text-gray-400">Всё, что нужно для локального AI-сервера</p>
  </div>

  <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
    <div class="p-6 rounded-2xl bg-surface border border-border hover:border-accent/50 transition group animate-slide-up">
      <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center text-xl mb-4 group-hover:scale-110 transition">🔌</div>
      <h3 class="font-semibold mb-2">OpenAI-совместимый</h3>
      <p class="text-sm text-gray-400">Работает с любым клиентом: Kai 9000, Open WebUI, Chatbox, SillyTavern, OpenAI SDK.</p>
    </div>
    <div class="p-6 rounded-2xl bg-surface border border-border hover:border-accent/50 transition group animate-slide-up" style="animation-delay: 0.05s;">
      <div class="w-10 h-10 rounded-lg bg-accent2/10 flex items-center justify-center text-xl mb-4 group-hover:scale-110 transition">🎯</div>
      <h3 class="font-semibold mb-2">5 моделей Qwen</h3>
      <p class="text-sm text-gray-400">qwen3.8-max, qwen3.7-max, qwen3.7-plus, qwen3.6-plus, qwen3.5-plus.</p>
    </div>
    <div class="p-6 rounded-2xl bg-surface border border-border hover:border-accent/50 transition group animate-slide-up" style="animation-delay: 0.1s;">
      <div class="w-10 h-10 rounded-lg bg-green-500/10 flex items-center justify-center text-xl mb-4 group-hover:scale-110 transition">🌊</div>
      <h3 class="font-semibold mb-2">SSE-стриминг</h3>
      <p class="text-sm text-gray-400">Ответы приходят в реальном времени, как от настоящего OpenAI API.</p>
    </div>
    <div class="p-6 rounded-2xl bg-surface border border-border hover:border-accent/50 transition group animate-slide-up" style="animation-delay: 0.15s;">
      <div class="w-10 h-10 rounded-lg bg-yellow-500/10 flex items-center justify-center text-xl mb-4 group-hover:scale-110 transition">🔄</div>
      <h3 class="font-semibold mb-2">Автообновление токена</h3>
      <p class="text-sm text-gray-400">Каждые 10 минут + за 5 минут до истечения. Ротация refresh_token и cookie.</p>
    </div>
    <div class="p-6 rounded-2xl bg-surface border border-border hover:border-accent/50 transition group animate-slide-up" style="animation-delay: 0.2s;">
      <div class="w-10 h-10 rounded-lg bg-pink-500/10 flex items-center justify-center text-xl mb-4 group-hover:scale-110 transition">👀</div>
      <h3 class="font-semibold mb-2">fs.watch</h3>
      <p class="text-sm text-gray-400">Прокси сам подхватывает новый auth-файл без перезапуска.</p>
    </div>
    <div class="p-6 rounded-2xl bg-surface border border-border hover:border-accent/50 transition group animate-slide-up" style="animation-delay: 0.25s;">
      <div class="w-10 h-10 rounded-lg bg-cyan-500/10 flex items-center justify-center text-xl mb-4 group-hover:scale-110 transition">🪶</div>
      <h3 class="font-semibold mb-2">Минимум зависимостей</h3>
      <p class="text-sm text-gray-400">Только встроенные модули Node.js. Никаких npm-пакетов.</p>
    </div>
  </div>
</section>

<!-- ===== INSTALL ===== -->
<section id="install" class="max-w-4xl mx-auto px-6 py-16">
  <div class="text-center mb-12">
    <h2 class="text-3xl md:text-4xl font-bold mb-3">🚀 <span class="gradient-text">Установка</span></h2>
    <p class="text-gray-400">Три шага до работающего API</p>
  </div>

  <!-- Tabs -->
  <div class="flex gap-1 p-1 rounded-xl bg-surface border border-border mb-8">
    <button class="tab-btn flex-1 px-4 py-2.5 rounded-lg text-sm font-medium bg-accent text-white transition" data-tab="tab-script">⚡ Bash-скрипт</button>
    <button class="tab-btn flex-1 px-4 py-2.5 rounded-lg text-sm font-medium text-gray-400 hover:text-white transition" data-tab="tab-github">🐙 GitHub</button>
  </div>

  <div id="tab-script" class="tab-panel">
    <div class="p-5 rounded-xl border border-accent/30 bg-accent/5 mb-6 text-sm text-gray-300">
      <strong class="text-white">Самый быстрый способ.</strong> Скопируй одну команду — скрипт создаст папку <code class="px-1.5 py-0.5 rounded bg-surface text-accent text-xs">~/qwen-proxy</code> со всеми файлами.
    </div>
    <pre class="p-5 rounded-xl bg-[#0d0f16] border border-border overflow-x-auto text-sm text-gray-300 mb-6"><code>bash <(curl -fsSL https://raw.githubusercontent.com/eldevex/qwn-trmx/main/setup.sh)</code></pre>
    <p class="text-sm text-gray-400 mb-3">После установки:</p>
    <pre class="p-5 rounded-xl bg-[#0d0f16] border border-border overflow-x-auto text-sm text-gray-300"><code>cd ~/qwen-proxy
cp ~/storage/downloads/qwen-dump-XXXX.json .
./update-auth.sh qwen-dump-XXXX.json
./start-qwen.sh</code></pre>
  </div>

  <div id="tab-github" class="tab-panel hidden">
    <div class="p-5 rounded-xl border border-accent/30 bg-accent/5 mb-6 text-sm text-gray-300">
      <strong class="text-white">Классический способ.</strong> Клонируй репозиторий и запусти вручную. Удобно, если хочешь обновлять код через <code class="px-1.5 py-0.5 rounded bg-surface text-accent text-xs">git pull</code>.
    </div>
    <pre class="p-5 rounded-xl bg-[#0d0f16] border border-border overflow-x-auto text-sm text-gray-300 mb-6"><code>cd ~
git clone https://github.com/eldevex/qwn-trmx.git
cd qwn-trmx
npm install
node qwen-proxy.js</code></pre>
    <p class="text-sm text-gray-400">Расширение для снятия дампа уже лежит в папке <code class="px-1.5 py-0.5 rounded bg-surface text-accent text-xs">extension/</code>.</p>
  </div>

  <!-- Steps -->
  <div class="mt-10 space-y-3">
    <details class="group rounded-xl bg-surface border border-border overflow-hidden">
      <summary class="flex items-center gap-3 p-4 cursor-pointer hover:bg-white/[0.02] transition">
        <span class="chevron text-gray-500 text-xs">▶</span>
        <span class="w-7 h-7 rounded-lg bg-accent/15 flex items-center justify-center text-xs font-bold text-accent">1</span>
        <span class="font-medium">Установи расширение в браузере</span>
      </summary>
      <div class="px-4 pb-4 pl-14 text-sm text-gray-400 space-y-2">
        <p>1. Открой <strong class="text-white">Kiwi Browser</strong> или <strong class="text-white">Titanium Browser</strong>.</p>
        <p>2. Включи <strong class="text-white">Режим разработчика</strong> в разделе расширений.</p>
        <p>3. Нажми <strong class="text-white">Load unpacked</strong> и выбери папку <code class="px-1.5 py-0.5 rounded bg-bg text-accent text-xs">extension/</code>.</p>
        <p>4. Иконка расширения появится на панели.</p>
      </div>
    </details>

    <details class="group rounded-xl bg-surface border border-border overflow-hidden">
      <summary class="flex items-center gap-3 p-4 cursor-pointer hover:bg-white/[0.02] transition">
        <span class="chevron text-gray-500 text-xs">▶</span>
        <span class="w-7 h-7 rounded-lg bg-accent/15 flex items-center justify-center text-xs font-bold text-accent">2</span>
        <span class="font-medium">Сделай дамп auth</span>
      </summary>
      <div class="px-4 pb-4 pl-14 text-sm text-gray-400 space-y-2">
        <p>1. Открой <code class="px-1.5 py-0.5 rounded bg-bg text-accent text-xs">chat.qwen.ai</code> в том же браузере.</p>
        <p>2. Залогинься в аккаунт.</p>
        <p>3. Нажми иконку расширения → <strong class="text-white">Dump</strong>.</p>
        <p>4. Сохрани файл <code class="px-1.5 py-0.5 rounded bg-bg text-accent text-xs">qwen-dump-XXXXX.json</code>.</p>
      </div>
    </details>

    <details class="group rounded-xl bg-surface border border-border overflow-hidden">
      <summary class="flex items-center gap-3 p-4 cursor-pointer hover:bg-white/[0.02] transition">
        <span class="chevron text-gray-500 text-xs">▶</span>
        <span class="w-7 h-7 rounded-lg bg-accent/15 flex items-center justify-center text-xs font-bold text-accent">3</span>
        <span class="font-medium">Загрузи дамп в прокси</span>
      </summary>
      <div class="px-4 pb-4 pl-14 text-sm text-gray-400 space-y-2">
        <pre class="p-4 rounded-lg bg-[#0d0f16] border border-border overflow-x-auto text-xs text-gray-300"><code>cd ~/qwen-proxy
cp ~/storage/downloads/qwen-dump-XXXXX.json .
chmod 644 qwen-dump-XXXXX.json
./update-auth.sh qwen-dump-XXXXX.json</code></pre>
        <p>В консоли увидишь:</p>
        <pre class="p-4 rounded-lg bg-[#0d0f16] border border-border overflow-x-auto text-xs text-green-400"><code>✅ qwen-auth.json: qwen-auth.json
   token:         eyJhbGciOiJIUzI1NiIs...
   refresh_token: eyJhbGciOiJIUzI1NiIs...
   cookie:        10 cookies, 716 chars
   bx-ua:         234!tFreKFaXeePWgnA3wjLkDBsIt...</code></pre>
      </div>
    </details>

    <details class="group rounded-xl bg-surface border border-border overflow-hidden">
      <summary class="flex items-center gap-3 p-4 cursor-pointer hover:bg-white/[0.02] transition">
        <span class="chevron text-gray-500 text-xs">▶</span>
        <span class="w-7 h-7 rounded-lg bg-accent/15 flex items-center justify-center text-xs font-bold text-accent">4</span>
        <span class="font-medium">Запусти прокси</span>
      </summary>
      <div class="px-4 pb-4 pl-14 text-sm text-gray-400 space-y-2">
        <pre class="p-4 rounded-lg bg-[#0d0f16] border border-border overflow-x-auto text-xs text-gray-300"><code>./start-qwen.sh</code></pre>
        <p>Вывод:</p>
        <pre class="p-4 rounded-lg bg-[#0d0f16] border border-border overflow-x-auto text-xs text-green-400"><code>✅ qwen-proxy запущен, PID 2607

Проверка:        curl http://localhost:5000/v1/health
Ручной refresh:  curl -X POST http://localhost:5000/v1/refresh
Логи:            tail -f ./proxy.log
Стоп:            pkill -f qwen-proxy.js</code></pre>
      </div>
    </details>

    <details class="group rounded-xl bg-surface border border-border overflow-hidden">
      <summary class="flex items-center gap-3 p-4 cursor-pointer hover:bg-white/[0.02] transition">
        <span class="chevron text-gray-500 text-xs">▶</span>
        <span class="w-7 h-7 rounded-lg bg-accent/15 flex items-center justify-center text-xs font-bold text-accent">5</span>
        <span class="font-medium">Проверь работу</span>
      </summary>
      <div class="px-4 pb-4 pl-14 text-sm text-gray-400 space-y-2">
        <pre class="p-4 rounded-lg bg-[#0d0f16] border border-border overflow-x-auto text-xs text-gray-300"><code># Health check
curl -s http://localhost:5000/v1/health | python3 -m json.tool

# Тестовый запрос
curl -s http://localhost:5000/v1/chat/completions \
  -H 'Content-Type: application/json' \
  -d '{"model":"qwen3.7-plus","messages":[{"role":"user","content":"привет"}]}' \
  | python3 -m json.tool</code></pre>
        <p>В health должно быть:</p>
        <ul class="list-disc list-inside space-y-1">
          <li><code class="text-green-400">token_expired: false</code></li>
          <li><code class="text-green-400">token_seconds_left</code> — порядка 800–900</li>
          <li><code class="text-green-400">has_refresh_token: true</code></li>
        </ul>
      </div>
    </details>
  </div>
</section>

<!-- ===== CLIENT ===== -->
<section class="max-w-4xl mx-auto px-6 py-16">
  <div class="text-center mb-10">
    <h2 class="text-3xl md:text-4xl font-bold mb-3">📱 <span class="gradient-text">Настройка клиента</span></h2>
    <p class="text-gray-400">Kai 9000, Open WebUI, Chatbox и другие</p>
  </div>

  <div class="grid md:grid-cols-3 gap-4 mb-8">
    <div class="p-5 rounded-xl bg-surface border border-border">
      <div class="text-xs text-gray-500 uppercase tracking-wider mb-2">Base URL</div>
      <code class="text-accent text-sm break-all">http://127.0.0.1:5000/v1</code>
    </div>
    <div class="p-5 rounded-xl bg-surface border border-border">
      <div class="text-xs text-gray-500 uppercase tracking-wider mb-2">API Key</div>
      <code class="text-accent text-sm">sk-qwen</code>
      <p class="text-xs text-gray-500 mt-2">любой — прокси не проверяет</p>
    </div>
    <div class="p-5 rounded-xl bg-surface border border-border">
      <div class="text-xs text-gray-500 uppercase tracking-wider mb-2">Model</div>
      <code class="text-accent text-sm">qwen3.7-plus</code>
      <p class="text-xs text-gray-500 mt-2">рекомендуется</p>
    </div>
  </div>

  <div class="rounded-xl border border-border overflow-hidden">
    <div class="p-4 bg-surface border-b border-border font-medium text-sm">Доступные модели</div>
    <div class="divide-y divide-border">
      <div class="flex items-center justify-between p-4 text-sm">
        <code class="text-accent">qwen3.8-max</code>
        <span class="text-gray-400">Флагман Qwen3.8, reasoning</span>
      </div>
      <div class="flex items-center justify-between p-4 text-sm">
        <code class="text-accent">qwen3.7-max</code>
        <span class="text-gray-400">Флагман Qwen3.7, reasoning</span>
      </div>
      <div class="flex items-center justify-between p-4 text-sm bg-green-500/5">
        <div class="flex items-center gap-2">
          <code class="text-green-400">qwen3.7-plus</code>
          <span class="px-2 py-0.5 rounded-full bg-green-500/15 text-green-400 text-xs">рекомендуется</span>
        </div>
        <span class="text-gray-400">Стабильнее всего</span>
      </div>
      <div class="flex items-center justify-between p-4 text-sm">
        <code class="text-accent">qwen3.6-plus</code>
        <span class="text-gray-400">Qwen3.6, лёгкая</span>
      </div>
      <div class="flex items-center justify-between p-4 text-sm">
        <code class="text-accent">qwen3.5-plus</code>
        <span class="text-gray-400">Qwen3.5, лёгкая</span>
      </div>
    </div>
  </div>
</section>

<!-- ===== FAQ ===== -->
<section id="faq" class="max-w-4xl mx-auto px-6 py-16">
  <div class="text-center mb-10">
    <h2 class="text-3xl md:text-4xl font-bold mb-3">❓ <span class="gradient-text">Частые проблемы</span></h2>
    <p class="text-gray-400">Спойлеры с решениями</p>
  </div>

  <div class="space-y-3">
    <details class="group rounded-xl bg-surface border border-border overflow-hidden">
      <summary class="flex items-center gap-3 p-4 cursor-pointer hover:bg-white/[0.02] transition">
        <span class="chevron text-gray-500 text-xs">▶</span>
        <span class="font-medium">Прокси отвечает пустотой (content: "")</span>
      </summary>
      <div class="px-4 pb-4 pl-12 text-sm text-gray-400 space-y-2">
        <p><strong class="text-white">Причина:</strong> у reasoning-моделей (Max) think-блок съедает весь лимит токенов.</p>
        <p><strong class="text-white">Решение:</strong> поднять <code class="px-1.5 py-0.5 rounded bg-bg text-accent text-xs">DEFAULT_MAX_TOKENS</code> или использовать <code class="px-1.5 py-0.5 rounded bg-bg text-accent text-xs">qwen3.7-plus</code>.</p>
        <pre class="p-4 rounded-lg bg-[#0d0f16] border border-border overflow-x-auto text-xs text-gray-300"><code>DEFAULT_MAX_TOKENS=65536 ./start-qwen.sh</code></pre>
      </div>
    </details>

    <details class="group rounded-xl bg-surface border border-border overflow-hidden">
      <summary class="flex items-center gap-3 p-4 cursor-pointer hover:bg-white/[0.02] transition">
        <span class="chevron text-gray-500 text-xs">▶</span>
        <span class="font-medium">Bad_Request: Invalid input too many messages</span>
      </summary>
      <div class="px-4 pb-4 pl-12 text-sm text-gray-400">
        <p><strong class="text-white">Причина:</strong> Qwen не принимает массив из нескольких сообщений. История должна быть вложена в одно сообщение.</p>
        <p class="mt-2"><strong class="text-white">Решение:</strong> прокси v7 решает это автоматически через <code class="px-1.5 py-0.5 rounded bg-bg text-accent text-xs">flattenMessages</code>.</p>
      </div>
    </details>

    <details class="group rounded-xl bg-surface border border-border overflow-hidden">
      <summary class="flex items-center gap-3 p-4 cursor-pointer hover:bg-white/[0.02] transition">
        <span class="chevron text-gray-500 text-xs">▶</span>
        <span class="font-medium">Bad_Request: Missing origin при refresh</span>
      </summary>
      <div class="px-4 pb-4 pl-12 text-sm text-gray-400">
        <p><strong class="text-white">Причина:</strong> в заголовках refresh-запроса нет <code class="px-1.5 py-0.5 rounded bg-bg text-accent text-xs">origin</code>.</p>
        <p class="mt-2"><strong class="text-white">Решение:</strong> в <code class="px-1.5 py-0.5 rounded bg-bg text-accent text-xs">buildRefreshHeaders()</code> должны быть:</p>
        <pre class="mt-2 p-4 rounded-lg bg-[#0d0f16] border border-border overflow-x-auto text-xs text-gray-300"><code>'origin': 'https://chat.qwen.ai',
'referer': 'https://chat.qwen.ai/',
'x-request-origin': 'https://chat.qwen.ai',</code></pre>
      </div>
    </details>

    <details class="group rounded-xl bg-surface border border-border overflow-hidden">
      <summary class="flex items-center gap-3 p-4 cursor-pointer hover:bg-white/[0.02] transition">
        <span class="chevron text-gray-500 text-xs">▶</span>
        <span class="font-medium">refresh failed постоянно, токен не обновляется</span>
      </summary>
      <div class="px-4 pb-4 pl-12 text-sm text-gray-400">
        <p><strong class="text-white">Причина:</strong> <code class="px-1.5 py-0.5 rounded bg-bg text-accent text-xs">refresh_token</code> отозван или истёк (~30 дней).</p>
        <p class="mt-2"><strong class="text-white">Решение:</strong> новый дамп → <code class="px-1.5 py-0.5 rounded bg-bg text-accent text-xs">./update-auth.sh новый.json</code>. Прокси подхватит токен автоматически.</p>
      </div>
    </details>

    <details class="group rounded-xl bg-surface border border-border overflow-hidden">
      <summary class="flex items-center gap-3 p-4 cursor-pointer hover:bg-white/[0.02] transition">
        <span class="chevron text-gray-500 text-xs">▶</span>
        <span class="font-medium">Расширение не устанавливается в браузер</span>
      </summary>
      <div class="px-4 pb-4 pl-12 text-sm text-gray-400 space-y-2">
        <ul class="list-disc list-inside space-y-1">
          <li>Убедись, что используешь Chromium-браузер с поддержкой расширений (<strong class="text-white">Kiwi Browser</strong> или <strong class="text-white">Titanium Browser</strong>) — в обычном Chrome на Android расширения не поддерживаются.</li>
          <li>Включи <strong class="text-white">Режим разработчика</strong> в настройках расширений.</li>
          <li>При «Load unpacked» выбирай папку <code class="px-1.5 py-0.5 rounded bg-bg text-accent text-xs">extension/</code>, а не файл внутри неё.</li>
        </ul>
      </div>
    </details>

    <details class="group rounded-xl bg-surface border border-border overflow-hidden">
      <summary class="flex items-center gap-3 p-4 cursor-pointer hover:bg-white/[0.02] transition">
        <span class="chevron text-gray-500 text-xs">▶</span>
        <span class="font-medium">Kai не подключается, запросы не доходят</span>
      </summary>
      <div class="px-4 pb-4 pl-12 text-sm text-gray-400">
        <ol class="list-decimal list-inside space-y-1">
          <li>Прокси запущен? <code class="px-1.5 py-0.5 rounded bg-bg text-accent text-xs">ps aux | grep qwen-proxy</code></li>
          <li>Health отвечает? <code class="px-1.5 py-0.5 rounded bg-bg text-accent text-xs">curl -s http://127.0.0.1:5000/v1/health</code></li>
          <li>URL в клиенте: <code class="px-1.5 py-0.5 rounded bg-bg text-accent text-xs">http://127.0.0.1:5000/v1</code> (не https)</li>
          <li>Смотри лог: <code class="px-1.5 py-0.5 rounded bg-bg text-accent text-xs">tail -n 30 ~/qwen-proxy/proxy.log</code></li>
        </ol>
      </div>
    </details>

    <details class="group rounded-xl bg-surface border border-border overflow-hidden">
      <summary class="flex items-center gap-3 p-4 cursor-pointer hover:bg-white/[0.02] transition">
        <span class="chevron text-gray-500 text-xs">▶</span>
        <span class="font-medium">Termux убивается Android'ом</span>
      </summary>
      <div class="px-4 pb-4 pl-12 text-sm text-gray-400 space-y-2">
        <ul class="list-disc list-inside space-y-1">
          <li>Дай Termux разрешение «Автозапуск» в настройках Android.</li>
          <li>Отключи оптимизацию батареи для Termux.</li>
          <li>Заблокируй Termux в недавних приложениях, чтобы Android не выгружал его.</li>
        </ul>
      </div>
    </details>
  </div>
</section>

<!-- ===== LIMITS ===== -->
<section class="max-w-4xl mx-auto px-6 py-16">
  <div class="p-6 rounded-2xl bg-surface border border-border">
    <h3 class="text-xl font-semibold mb-4 flex items-center gap-2">⚠️ Ограничения</h3>
    <ul class="space-y-2 text-sm text-gray-400">
      <li class="flex gap-3"><span class="text-yellow-400">•</span> История диалога каждый раз вкладывается в одно сообщение — расходует больше токенов, чем «нативный» чат.</li>
      <li class="flex gap-3"><span class="text-yellow-400">•</span> <code class="px-1.5 py-0.5 rounded bg-bg text-accent text-xs">refresh_token</code> живёт ~30 дней. После — нужен новый дамп.</li>
      <li class="flex gap-3"><span class="text-yellow-400">•</span> <code class="px-1.5 py-0.5 rounded bg-bg text-accent text-xs">bx-ua</code> / <code class="px-1.5 py-0.5 rounded bg-bg text-accent text-xs">bx-umidtoken</code> не обновляются автоматически — берутся из дампа.</li>
      <li class="flex gap-3"><span class="text-yellow-400">•</span> Прокси не запускается после перезагрузки телефона — нужно запускать вручную.</li>
      <li class="flex gap-3"><span class="text-yellow-400">•</span> Расширение работает только в Chromium-браузерах с поддержкой расширений (Kiwi, Titanium).</li>
    </ul>
  </div>
</section>

<!-- ===== FOOTER ===== -->
<footer class="border-t border-border mt-16">
  <div class="max-w-4xl mx-auto px-6 py-10 text-center">
    <div class="flex items-center justify-center gap-2 mb-4">
      <span class="w-8 h-8 rounded-lg bg-gradient-to-br from-accent to-accent2 flex items-center justify-center text-white text-sm font-bold">Q</span>
      <span class="font-semibold gradient-text">Qwen Proxy</span>
    </div>
    <p class="text-sm text-gray-500 mb-4">OpenAI-совместимый API для Qwen Web Chat · Termux · Node.js</p>
    <div class="flex items-center justify-center gap-4 text-sm">
      <a href="https://github.com/eldevex/qwn-trmx" target="_blank" class="text-gray-400 hover:text-white transition">GitHub</a>
      <span class="text-gray-700">·</span>
      <a href="https://github.com/eldevex/qwn-trmx/issues" target="_blank" class="text-gray-400 hover:text-white transition">Issues</a>
    </div>
    <p class="text-xs text-gray-600 mt-6">Сделано для личного использования. Используйте ответственно.</p>
  </div>
</footer>

<script>
  // Tabs
  document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.tab-btn').forEach(b => {
        b.classList.remove('bg-accent', 'text-white');
        b.classList.add('text-gray-400');
      });
      document.querySelectorAll('.tab-panel').forEach(p => p.classList.add('hidden'));
      btn.classList.add('bg-accent', 'text-white');
      btn.classList.remove('text-gray-400');
      document.getElementById(btn.dataset.tab).classList.remove('hidden');
    });
  });

  // Copy buttons
  document.querySelectorAll('pre').forEach(pre => {
    const btn = document.createElement('button');
    btn.className = 'copy-btn';
    btn.textContent = 'копировать';
    btn.addEventListener('click', () => {
      const code = pre.querySelector('code') || pre;
      navigator.clipboard.writeText(code.textContent).then(() => {
        btn.textContent = '✅ готово';
        btn.classList.add('copied');
        setTimeout(() => {
          btn.textContent = 'копировать';
          btn.classList.remove('copied');
        }, 1500);
      });
    });
    pre.appendChild(btn);
  });
</script>

</body>
</html>
